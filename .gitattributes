# 3D CAD models of the KiCad projects live in Git LFS (owner's decision).
# Both letter cases are listed on purpose: Git attribute patterns are case
# sensitive, and the vendor files use *.step, *.STEP, *.stp and *.STP alike.
*.step  filter=lfs diff=lfs merge=lfs -text
*.STEP  filter=lfs diff=lfs merge=lfs -text
*.stp   filter=lfs diff=lfs merge=lfs -text
*.STP   filter=lfs diff=lfs merge=lfs -text
*.stl   filter=lfs diff=lfs merge=lfs -text
*.STL   filter=lfs diff=lfs merge=lfs -text
*.wrl   filter=lfs diff=lfs merge=lfs -text
*.WRL   filter=lfs diff=lfs merge=lfs -text
# Vendor 3D-model archives (e.g. antenna-sw868-th13-1.snapshot.4.zip, 6 MB) are stored in LFS too;
# gerber_to_order/*.zip stay in normal Git so they can be downloaded directly.
**/3D_Models/**/*.zip filter=lfs diff=lfs merge=lfs -text
